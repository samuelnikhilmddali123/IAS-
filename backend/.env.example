# JWT Secret Key for token signing
JWT_SECRET=canteen_super_secret_jwt_key_2026_secure

# Restaurant / Hotel UPI Payment Configuration
RESTAURANT_UPI_ID=canteen.ias@upi
RESTAURANT_NAME=IAS Officers Mess Canteen
