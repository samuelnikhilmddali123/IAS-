# Server Port
PORT=5001

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/canteen
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/canteen?retryWrites=true&w=majority
